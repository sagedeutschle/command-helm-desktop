  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A8A8A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#00D084"
      }
    },
    {
      "name": "String escape sequences / template placeholders",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#37FF9A"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#FF8AA1"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "Language constants (true/false/null/this/super)",
      "scope": [
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#FFD166",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Other constants / support constants",
      "scope": [
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#FF5C7A"
      }
    },
    {
      "name": "Control-flow keywords",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#FF0033",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#FF8AA1"
      }
    },
    {
      "name": "Storage: var/function/class keywords and modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FF0033",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Import / export / module keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.other.import",
        "keyword.other.export"
      ],
      "settings": {
        "foreground": "#FF365C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes, types, interfaces, enums",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.type.interface",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#D98CFF"
      }
    },
    {
      "name": "Namespaces / modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#E7B3FF"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#4DA3FF"
      }
    },
    {
      "name": "Decorators / annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#FFD166",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#84F0FF"
      }
    },
    {
      "name": "Variables and object literal keys",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Object / support properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#45E3FF"
      }
    },
    {
      "name": "Constants and readonly variables",
      "scope": [
        "variable.other.constant",
        "variable.readonly"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "Tags (HTML/XML/JSX)",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FF7A92"
      }
    },
    {
      "name": "Attribute names",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#D8D8D8"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#FF5C7A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4DA3FF"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8A8A8A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline / fenced code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#00D084"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#00D084"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF5C7A"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#4DA3FF"
      }
    },
    {
      "name": "Invalid / illegal",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#FF0033",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FFD166",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS/SCSS/LESS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#4DA3FF"
      }
    },
    {
      "name": "CSS property values / units",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "JSON property names",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#45E3FF"
      }
    },
    {
      "name": "Hidden dotenv keys (helm secrets-hygiene convention, ported verbatim)",
      "scope": [
        "keyword.other.dotenv"
      ],
      "settings": {
        "foreground": "#FF000000"
      }
    }
  ]
}
